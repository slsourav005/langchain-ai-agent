    {
      "cell_type": "markdown",
      "source": [
        "### Build Agent\n"
      ],
      "metadata": {
        "id": "GBYVkViy98Un"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "react_prompt = PromptTemplate.from_template(\"\"\"You are a helpful AI assistant. Answer the question using the tools available.\n",
        "\n",
        "You have access to these tools:\n",
        "{tools}\n",
        "\n",
        "Use EXACTLY this format:\n",
        "\n",
        "Question: the input question\n",
        "Thought: think about what to do\n",
        "Action: one of [{tool_names}]\n",
        "Action Input: input to the action\n",
        "Observation: result of the action\n",
        "... (repeat Thought/Action/Action Input/Observation as needed)\n",
        "Thought: I now know the final answer\n",
        "Final Answer: the final answer to the question\n",
        "\n",
        "Important rules:\n",
        "- Always start with Thought:\n",
        "- Action must be exactly one of the tool names listed\n",
        "- Always end with Final Answer:\n",
        "\n",
        "Begin!\n",
        "\n",
        "Question: {input}\n",
        "Thought:{agent_scratchpad}\"\"\")\n"
      ],
      "metadata": {
        "id": "pXiBix9x5Y35"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "agent = create_react_agent(llm = llm, tools = tools, prompt = react_prompt)"
      ],
      "metadata": {
        "id": "ny3BBzJV57rZ"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "agent_executor = AgentExecutor(\n",
        "    agent = agent,\n",
        "    tools = tools,\n",
        "    verbose=True,\n",
        "    max_iterations=6,\n",
        "    handle_parsing_errors=True\n",
        ")"
      ],
