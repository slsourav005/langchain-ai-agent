    {
      "cell_type": "code",
      "metadata": {
        "id": "cb0d5967"
      },
      "source": [
        "import gradio as gr\n",
        "\n",
        "\n",
        "def chat_interface(message, history):\n",
        "    try:\n",
        "        query = message.strip()\n",
        "\n",
        "        # Reset memory and rebuild it from this chat session\n",
        "        memory_executor.memory.clear()\n",
        "\n",
        "        for turn in history:\n",
        "            if isinstance(turn, dict):\n",
        "                role = turn.get(\"role\")\n",
        "                content = turn.get(\"content\", \"\")\n",
        "\n",
        "                if role == \"user\":\n",
        "                    pending_user = str(content)\n",
        "\n",
        "                elif role == \"assistant\":\n",
        "                    if \"pending_user\" in locals():\n",
        "                        memory_executor.memory.save_context(\n",
        "                            {\"input\": pending_user},\n",
        "                            {\"output\": str(content)}\n",
        "                        )\n",
        "                        del pending_user\n",
        "\n",
        "            elif isinstance(turn, (list, tuple)) and len(turn) == 2:\n",
        "                user_msg, ai_msg = turn\n",
        "\n",
        "                memory_executor.memory.save_context(\n",
        "                    {\"input\": str(user_msg or \"\")},\n",
        "                    {\"output\": str(ai_msg or \"\")}\n",
        "                )\n",
        "\n",
        "        response = memory_executor.invoke({\"input\": query})\n",
        "\n",
        "        return response.get(\"output\", \"No response generated.\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"ERROR:\", repr(e))\n",
        "        return \"Something went wrong. Please try again.\"\n",
        "\n",
        "\n",
        "# Wrap ChatInterface inside a Blocks context cleanly\n",
        "with gr.Blocks() as demo:\n",
        "    gr.Markdown(\"# 🤖 Memory-Enabled AI Agent\")\n",
        "    gr.Markdown(\"Ask me questions! I have access to a calculator, a weather retriever, an AI knowledge base, and I can remember our conversation history.\")\n",
        "\n",
        "    gr.ChatInterface(\n",
        "        fn=chat_interface,\n",
        "        examples=[\n",
        "            \"Hi! My name is Sourav.\",\n",
        "            \"What is my name?\",\n",
        "            \"What is the square root of 256?\",\n",
        "            \"What's the weather like in Mumbai?\",\n",
        "            \"What is LangChain?\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "# Launch the web application safely\n",
        "demo.launch(share=True, theme=gr.themes.Soft())"
      ],
      "execution_count": null,
      "outputs": []
    }
