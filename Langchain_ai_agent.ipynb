    {
      "cell_type": "markdown",
      "source": [
        "### Add Memory"
      ],
      "metadata": {
        "id": "2Ewk9TqS-El1"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "from langchain_classic.agents import create_tool_calling_agent, AgentExecutor\n",
        "from langchain_core.prompts import ChatPromptTemplate, MessagesPlaceholder\n",
        "from langchain_classic.memory import ConversationBufferMemory\n",
        "\n",
        "# Create a prompt that supports conversation memory\n",
        "memory_prompt = ChatPromptTemplate.from_messages([\n",
        "    (\"system\", \"\"\"\n",
        "    You are a helpful AI assistant.\n",
        "    Use the available tools when needed.\n",
        "    Give a clear final answer after using tools.\n",
        "    Avoid repeating the same tool unnecessarily.\n",
        "    \"\"\"),\n",
        "    MessagesPlaceholder(variable_name=\"chat_history\"),\n",
        "    (\"human\", \"{input}\"),\n",
        "    MessagesPlaceholder(variable_name=\"agent_scratchpad\")\n",
        "])\n",
        "\n",
        "# Create memory\n",
        "memory = ConversationBufferMemory(\n",
        "    memory_key=\"chat_history\",\n",
        "    return_messages=True\n",
        ")\n",
        "\n",
        "# Create tool-calling agent\n",
        "memory_agent = create_tool_calling_agent(\n",
        "    llm,\n",
        "    tools,\n",
        "    memory_prompt\n",
        ")\n",
        "\n",
        "# Create executor\n",
        "memory_executor = AgentExecutor(\n",
        "    agent=memory_agent,\n",
        "    tools=tools,\n",
        "    memory=memory,\n",
        "    verbose=True,\n",
        "    max_iterations=5\n",
        ")\n",
        "\n",
        "print(\"New memory-enabled agent is ready!\")\n"
      ],
      "metadata": {
        "id": "Nbq1YglH7WD0"
      },
      "execution_count": null,
      "outputs": []
    },
